# ── Browser (public) ─ safe to expose: RLS protects every table.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key (sb_publishable_…). The legacy anon key also works via VITE_SUPABASE_ANON_KEY.
VITE_SUPABASE_PUBLISHABLE_KEY=

# ── Server only (Vercel → Environment Variables). NEVER prefix with VITE_.
# Used solely by api/invite-candidate.js after it verifies the caller is a Tech Champion.
SUPABASE_URL=https://your-project-ref.supabase.co
# Secret key (sb_secret_…), or the legacy service_role key.
SUPABASE_SECRET_KEY=
